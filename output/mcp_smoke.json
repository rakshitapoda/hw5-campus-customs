        "days_until_due": 2,
        "is_overdue": false
      },
      "db_verification": {
        "sql": "SELECT * FROM leases WHERE id=1; SELECT date_today FROM desk",
        "expected_from_db": {
          "id": 1,
          "landlord": "Elm City Properties",
          "monthly_rent": 2400.0,
          "next_due": "2026-09-02",
          "date_today": "2026-08-31"
        },
        "matches_db": true,
        "mismatches": {}
      }
    },
    {
      "prompt": "Tickets 101 and 103 need an apparel restock. Check vendor 1 (Bulldog Print Co): what is its lead time, does it have any open unpaid invoices, and can it ship new products?",
