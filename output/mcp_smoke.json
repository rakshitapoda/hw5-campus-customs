          ],
          "open_balance": 840.0,
          "can_ship": false
        }
      ],
      "db_verification": {
        "sql": "SELECT * FROM vendors WHERE id=1; SELECT id, amount, due_date, status FROM invoices WHERE vendor_id=1 AND status='open'",
        "expected_from_db": {
          "id": 1,
