        "size": "M",
        "qty": 8,
        "location": "Aisle A",
        "in_stock": true,
        "unit_cost": 22.0,
        "list_price": 58.0
      },
      "db_verification": {
        "sql": "SELECT i.*, p.unit_cost, p.list_price FROM inventory i JOIN pricing p USING(sku) WHERE sku='CC-HOOD-NAVY' AND size='M'",
        "expected_from_db": {
          "sku": "CC-HOOD-NAVY",
          "name": "Basic Hoodie Big Yale",
          "size": "M",
          "qty": 8,
          "location": "Aisle A",
          "unit_cost": 22.0,
          "list_price": 58.0
        },
        "matches_db": true,
        "mismatches": {}
      }
    },
    {
      "prompt": "Ticket 102: Elm City Properties says rent is due in 2 days. Look up lease 1 and tell me the landlord, monthly rent, next due date, and how many days until it is due from the shop's date_today.",
      "tool": "get_lease",
      "arguments": {
        "lease_id": 1
      },
      "is_error": false,
      "output": {
        "id": 1,
        "space_name": "Chapel Street shop",
        "landlord": "Elm City Properties",
        "monthly_rent": 2400.0,
        "next_due": "2026-09-02",
        "notes": null,
