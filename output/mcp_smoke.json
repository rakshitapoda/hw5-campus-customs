{
  "server": "campus-customs",
  "connection": {
    "config_file": ".mcp.json",
    "transport": "stdio",
    "command": ".venv/bin/python",
    "args": [
      "mcp_server/server.py"
    ]
  },
  "database": "data/campus_customs_new.db",
  "shop_date_today": "2026-08-31",
  "tested_at": "2026-10-11T16:57:50+00:00",
  "tools_listed": [
    "check_inventory",
    "get_lease",
    "check_vendor_status"
  ],
  "all_match_db": true,
  "tests": [
    {
      "prompt": "Ticket 101: Tauhid Zaman wants one Classic Bulldog Tee (CC-TEE-WHITE) in size S. Do we have it in stock, and what are its unit cost and list price?",
      "tool": "check_inventory",
      "arguments": {
        "sku": "CC-TEE-WHITE",
        "size": "S"
      },
      "is_error": false,
      "output": {
        "sku": "CC-TEE-WHITE",
        "name": "Classic Bulldog Tee",
        "size": "S",
        "qty": 0,
        "location": "Aisle B",
        "in_stock": false,
        "unit_cost": 8.0,
        "list_price": 28.0
      },
      "db_verification": {
        "sql": "SELECT i.*, p.unit_cost, p.list_price FROM inventory i JOIN pricing p USING(sku) WHERE sku='CC-TEE-WHITE' AND size='S'",
        "expected_from_db": {
          "sku": "CC-TEE-WHITE",
          "name": "Classic Bulldog Tee",
          "size": "S",
          "qty": 0,
          "location": "Aisle B",
          "unit_cost": 8.0,
          "list_price": 28.0
        },
        "matches_db": true,
        "mismatches": {}
      }
    },
    {
      "prompt": "Ticket 103: Yale AI Club wants 20 Basic Hoodie Big Yale (CC-HOOD-NAVY) in size M with a bulk discount. How many are on hand, and what are the unit cost and list price?",
      "tool": "check_inventory",
      "arguments": {
        "sku": "CC-HOOD-NAVY",
        "size": "M"
      },
      "is_error": false,
      "output": {
        "sku": "CC-HOOD-NAVY",
